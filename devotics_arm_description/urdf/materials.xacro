<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Devotics Signature Color Palette -->
  <material name="devotics_orange">
    <color rgba="0.95 0.35 0.05 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.22 0.24 0.26 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>

  <material name="metallic_silver">
    <color rgba="0.85 0.86 0.88 1.0"/>
  </material>

  <material name="accent_blue">
    <color rgba="0.10 0.50 0.85 1.0"/>
  </material>

  <material name="rubber_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

</robot>
